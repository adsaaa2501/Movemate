{
  "expo": {
    "name": "MoveMateRebuild",
    "slug": "MoveMateRebuild",
    "version": "1.0.0",
    "orientation": "all",
    "icon": "./assets/images/icon.png",
    "scheme": "movematerebuild",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MoveMate memakai lokasi untuk menentukan titik penjemputan dan tujuan pindahan."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MoveMate memakai kamera untuk mendokumentasikan kondisi barang sebelum dipindahkan."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
